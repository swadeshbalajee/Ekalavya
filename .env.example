SCHOLARMOTION_ENV=development
APP_API_KEY=
ADMIN_API_KEY=
MEDIA_CORS_ORIGINS=http://127.0.0.1:8501,http://localhost:8501
DATABASE_URL=postgresql+asyncpg://scholarmotion:scholarmotion@127.0.0.1:5432/scholarmotion
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=scholarmotion
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_ROOT=./projects
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=scholarmotion
S3_ACCESS_KEY=minio
S3_SECRET_KEY=miniosecret
MAIN_LLM_PROVIDER=mock
MAIN_LLM_API_KEY=
MAIN_LLM_MODEL=deterministic-v1
MAIN_LLM_FALLBACK_MODELS=
MAIN_LLM_BASE_URL=
MAIN_LLM_TEMPERATURE=0.2
# Thinking budget for script drafts/reviews (reasoning tokens bill as output).
MAIN_LLM_STRUCTURED_REASONING_EFFORT=high
# Optional cheaper model (same provider/key/base URL as MAIN_LLM_*) for intent
# preparation, storyboard and lesson-flow review, e.g. anthropic/claude-haiku-5.5.
# Falls back to MAIN_LLM_MODEL if it fails. Empty uses MAIN_LLM_MODEL.
PLANNER_LLM_MODEL=
PLANNER_REASONING_EFFORT=low
# Local forced alignment of narration (CPU, ~1.2 GB model downloaded once).
# Disable to fall back to word-share timing estimates.
NARRATION_ALIGNMENT=true
NARRATION_ALIGNER_MODEL=MahmoudAshraf/mms-300m-1130-forced-aligner
# Shared Google AI Studio key. Gemini capability-specific API_KEY values fall
# back to this, so one key can be used across planning, code, vision, and media.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional independent translator. If blank, translation uses MAIN_LLM_*.
# Every planner/script/code agent remains canonical English; this provider only
# localizes learner-visible video text, narration, and tutor replies.
TRANSLATION_PROVIDER=
TRANSLATION_API_KEY=
TRANSLATION_MODEL=
TRANSLATION_BASE_URL=
# Code, vision, speech, and transcription are independently configurable
# capability APIs. Leave blank to use the deterministic local mocks.
CODE_PROVIDER=
CODE_API_KEY=
CODE_MODEL=
CODE_FALLBACK_MODELS=
CODE_BASE_URL=
CODE_GENERATION_TIMEOUT_SECONDS=60
CODE_REASONING_EFFORT=low
CODE_MAX_OUTPUT_TOKENS=6000
VISUAL_LLM_PROVIDER=
VISUAL_LLM_API_KEY=
VISUAL_LLM_MODEL=
VISUAL_LLM_FALLBACK_MODELS=
VISUAL_LLM_BASE_URL=
# Optional scene-level AV reviewer. With OpenRouter configured, each rendered
# scene is checked against its exact narration audio before assembly.
VIDEO_VERIFICATION_ENABLED=true
VIDEO_LLM_PROVIDER=openai_compatible
VIDEO_LLM_API_KEY=
VIDEO_LLM_MODEL=google/gemini-2.5-flash-lite
VIDEO_LLM_BASE_URL=https://openrouter.ai/api/v1
VIDEO_LLM_REASONING_EFFORT=low
# TTS_PROVIDER: mock | gemini | openai_compatible | elevenlabs | kokoro_http
# For elevenlabs: TTS_API_KEY is your xi-api-key, TTS_MODEL is a model id (e.g.
# eleven_flash_v2_5), TTS_VOICE is an ElevenLabs voice_id (default: Rachel).
TTS_PROVIDER=mock
TTS_API_KEY=
TTS_MODEL=deterministic-v1
TTS_BASE_URL=
TTS_VOICE=alloy
# Gemini TTS through OpenRouter requires PCM and an explicit provider voice:
# TTS_MODEL=google/gemini-3.8-flash-lite-tts
# TTS_VOICE=Kore
# TTS_RESPONSE_FORMAT=pcm
TTS_RESPONSE_FORMAT=mp3
TTS_PCM_SAMPLE_RATE=24000
# Optional provider-supported speaking-style instructions; the default is a clear STEM tutor.
# TTS_INSTRUCTIONS=
# Bodhan AI (https://console.bodhan.ai): when a key is set, translation and narration
# for Bengali, English, Hindi, Marathi, Tamil and Telugu use Bodhan; other languages
# and failed translations use the providers above. Keys are issued per model, so
# separate translate/TTS keys override BODHAN_API_KEY.
BODHAN_API_KEY=
BODHAN_TRANSLATE_API_KEY=
BODHAN_TTS_API_KEY=
BODHAN_TTS_VOICE=Kavya
# Per-language voices, e.g. ta:VoiceName,te:VoiceName (any voice can read any language).
BODHAN_TTS_VOICES=
BODHAN_TTS_STYLE=educational lecture
# Dollars per rupee, used to show Bodhan's INR prices in dollars.
USD_PER_INR=0.012
STT_PROVIDER=mock
STT_API_KEY=
STT_MODEL=deterministic-v1
STT_BASE_URL=
# For a locally hosted Kokoro-82M server:
# TTS_PROVIDER=kokoro_http
# TTS_BASE_URL=http://127.0.0.1:8811
# TTS_VOICE=af_heart
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_SOURCE_COLLECTION=scholarmotion_source_chunks
QDRANT_SKILL_COLLECTION=scholarmotion_skills
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
MAX_CONCURRENT_SCENES=4
MAX_RENDER_WORKERS=2
MAX_LLM_REQUESTS=4
RENDER_TIMEOUT_SECONDS=180
FFMPEG_BINARY=ffmpeg
MANIM_BINARY=manim
SANDBOX_MEMORY_LIMIT_MB=2048
SANDBOX_CPU_SECONDS=180
# RLIMIT_NPROC is per Unix user. Set a positive value only for a dedicated
# renderer account or a cgroup/container; use 0 for a shared local login.
SANDBOX_PROCESS_LIMIT=0
SANDBOX_ISOLATION=auto
