SCHOLARMOTION_ENV=development
APP_API_KEY=
ADMIN_API_KEY=
MEDIA_CORS_ORIGINS=http://127.0.0.1:8501,http://localhost:8501
DATABASE_URL=postgresql+asyncpg://scholarmotion:scholarmotion@127.0.0.1:5432/scholarmotion
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=scholarmotion
OBJECT_STORAGE_BACKEND=local
# Project files live in <root>/<owner_id>/<project_id>/. Use an absolute path to
# share one folder between checkouts; Docker mounts PROJECTS_DIR at /app/projects.
# After moving it, run scripts/migrate_project_storage.py to update stored paths.
OBJECT_STORAGE_ROOT=./projects
# PROJECTS_DIR=./projects
# Lessons learned from failures, a folder of notes per agent that people can
# read and edit; Docker mounts CORRECTION_DIR at /app/correction_folder.
CORRECTION_FOLDER=./correction_folder
# CORRECTION_DIR=./correction_folder
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=scholarmotion
S3_ACCESS_KEY=minio
S3_SECRET_KEY=miniosecret
# Every capability below defaults to OpenRouter, so OPENROUTER_API_KEY is the
# only key needed. Set a capability's *_PROVIDER=mock (MAIN_LLM_MODEL,
# TTS_MODEL and STT_MODEL=deterministic-v1) for offline runs.
MAIN_LLM_PROVIDER=openai_compatible
MAIN_LLM_API_KEY=
# Writes the lesson script and paper outline. Open models cost a fraction of
# Claude; the fallback takes over when the main model fails or is unavailable.
MAIN_LLM_MODEL=z-ai/glm-5.3
MAIN_LLM_FALLBACK_MODELS=anthropic/claude-sonnet-5.5
MAIN_LLM_BASE_URL=https://openrouter.ai/api/v1
MAIN_LLM_TEMPERATURE=0.2
AGENT_TEMPERATURE=0.7
# Thinking budget for script drafts/reviews (reasoning tokens bill as output).
MAIN_LLM_STRUCTURED_REASONING_EFFORT=high
# Papers go to the main model as PDFs. Models that read files (Claude, Gemini,
# GPT) get the PDF itself; for others OpenRouter converts it to text with this
# engine: cloudflare-ai (free) or mistral-ocr (~$2 per 1,000 pages, better OCR).
OPENROUTER_PDF_ENGINE=cloudflare-ai
# Optional cheaper model (same provider/key/base URL as MAIN_LLM_*) for intent
# preparation, storyboard and lesson-flow review.
# Falls back to MAIN_LLM_MODEL if it fails. Empty uses MAIN_LLM_MODEL.
PLANNER_LLM_MODEL=z-ai/glm-5.3-flash
PLANNER_REASONING_EFFORT=low
# Safety screen: a small model checks every chat message (politics, hate,
# dangerous or cheating requests are declined gently; the educational side of a
# topic is allowed). Same provider/key/base URL as MAIN_LLM_*. Empty turns it off.
GUARDRAIL_MODEL=openai/gpt-oss-safeguard-20b
GUARDRAIL_TIMEOUT_SECONDS=10
# What happens when the safety model itself fails: true lets the message through.
GUARDRAIL_ALLOW_ON_ERROR=true
# Local forced alignment of narration (CPU, ~1.2 GB model downloaded once).
# Disable to fall back to word-share timing estimates.
NARRATION_ALIGNMENT=true
NARRATION_ALIGNER_MODEL=MahmoudAshraf/mms-300m-1130-forced-aligner
# Shared Google AI Studio key. Gemini capability-specific API_KEY values fall
# back to this, so one key can be used across planning, code, vision, and media.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional independent translator. If blank, translation uses MAIN_LLM_*.
# Every planner/script/code agent remains canonical English; this provider only
# localizes learner-visible video text, narration, and tutor replies.
TRANSLATION_PROVIDER=openai_compatible
TRANSLATION_API_KEY=
TRANSLATION_MODEL=google/gemini-2.5-flash-lite
TRANSLATION_BASE_URL=https://openrouter.ai/api/v1
# Code, vision, speech, and transcription are independently configurable
# capability APIs. Leave a provider blank to use the deterministic local mock.
CODE_PROVIDER=openai_compatible
CODE_API_KEY=
# GLM-5.3 Flash writes and repairs scenes (~$0.007 a scene in our tests).
# CODE_FALLBACK_MODELS answer only when the code model is down or cut off.
CODE_MODEL=z-ai/glm-5.3-flash
CODE_FALLBACK_MODELS=anthropic/claude-haiku-5.5
CODE_BASE_URL=https://openrouter.ai/api/v1
CODE_GENERATION_TIMEOUT_SECONDS=240
CODE_REASONING_EFFORT=medium
# Room for the code itself; a model's thinking cap (MODEL_THINKING) is added on top.
CODE_MAX_OUTPUT_TOKENS=16000
# After the code model has failed a scene this many times, this model fixes
# its code (with the reviewer's findings and stills), then starts fresh if
# that fails too. Empty turns the hand-over off.
CODE_ESCALATION_MODEL=anthropic/claude-sonnet-5.5
CODE_ESCALATION_AFTER_FAILURES=2
# Thinking rule per model: "model=6000" caps thinking tokens, "model=off"
# turns it off, "model=low|medium|high" sets an effort; "provider/" matches
# all of that provider's models. Several open models ignore effort levels and
# think until the output limit unless capped. Unset uses the built-in rules.
# MODEL_THINKING=z-ai/glm-5.3-flash=6000,z-ai/glm-5.3=8000,qwen/qwen3.8-omni-flash=off,qwen/=4000,deepseek/=4000,moonshotai/=4000
VISUAL_LLM_PROVIDER=openai_compatible
VISUAL_LLM_API_KEY=
VISUAL_LLM_MODEL=z-ai/glm-5.3-flash
VISUAL_LLM_FALLBACK_MODELS=google/gemini-3.8-flash
VISUAL_LLM_BASE_URL=https://openrouter.ai/api/v1
# Box the parts of paper figures a scene highlights: the first model locates
# them, the second takes a look when a box is implausible. Empty turns it off.
FIGURE_LOCATOR_MODELS=google/gemini-3.8-flash,anthropic/claude-sonnet-5.5
# Optional scene-level AV reviewer. With OpenRouter configured, each rendered
# scene is checked against its exact narration audio before assembly.
VIDEO_VERIFICATION_ENABLED=true
VIDEO_LLM_PROVIDER=openai_compatible
VIDEO_LLM_API_KEY=
# Watches each scene with its narration and answers a 10-item checklist.
VIDEO_LLM_MODEL=qwen/qwen3.8-omni-flash
VIDEO_LLM_FALLBACK_MODELS=google/gemini-3.8-flash
VIDEO_LLM_BASE_URL=https://openrouter.ai/api/v1
VIDEO_LLM_REASONING_EFFORT=low
# TTS_PROVIDER: mock | gemini | openai_compatible | elevenlabs | kokoro_http
# For elevenlabs: TTS_API_KEY is your xi-api-key, TTS_MODEL is a model id (e.g.
# eleven_flash_v2_5), TTS_VOICE is an ElevenLabs voice_id (default: Rachel).
# Gemini TTS through OpenRouter requires PCM and an explicit provider voice.
TTS_PROVIDER=openai_compatible
TTS_API_KEY=
TTS_MODEL=google/gemini-3.8-flash-lite-tts
TTS_BASE_URL=https://openrouter.ai/api/v1
TTS_VOICE=Kore
TTS_RESPONSE_FORMAT=pcm
TTS_PCM_SAMPLE_RATE=24000
# Optional provider-supported speaking-style instructions; the default is a clear STEM tutor.
# TTS_INSTRUCTIONS=
# Bodhan AI (https://console.bodhan.ai): when a key is set, translation and narration
# for Bengali, English, Hindi, Marathi, Tamil and Telugu use Bodhan; other languages
# and failed translations use the providers above. Keys are issued per model, so
# separate translate/TTS keys override BODHAN_API_KEY.
BODHAN_API_KEY=
BODHAN_TRANSLATE_API_KEY=
BODHAN_TTS_API_KEY=
BODHAN_TTS_VOICE=Kavya
# Per-language voices, e.g. ta:VoiceName,te:VoiceName (any voice can read any language).
BODHAN_TTS_VOICES=
BODHAN_TTS_STYLE=educational lecture
# Dollars per rupee, used to show Bodhan's INR prices in dollars.
USD_PER_INR=0.012
# Usernames (comma-separated) that see every user's usage on the dashboard.
ADMIN_USERNAMES=admin
STT_PROVIDER=openai_compatible
STT_API_KEY=
STT_MODEL=openai/whisper-large-v3
STT_BASE_URL=https://openrouter.ai/api/v1
# For a locally hosted Kokoro-82M server:
# TTS_PROVIDER=kokoro_http
# TTS_BASE_URL=http://127.0.0.1:8811
# TTS_VOICE=af_heart
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_SOURCE_COLLECTION=scholarmotion_source_chunks
QDRANT_SKILL_COLLECTION=scholarmotion_skills
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
MAX_CONCURRENT_SCENES=4
MAX_RENDER_WORKERS=2
MAX_LLM_REQUESTS=4
# Per-request model limits in seconds. Script writing, storyboards and lesson
# reviews write a whole lesson in one answer, so they get the longer limit.
LLM_REQUEST_TIMEOUT_SECONDS=90
LLM_LONG_REQUEST_TIMEOUT_SECONDS=420
RENDER_TIMEOUT_SECONDS=180
FFMPEG_BINARY=ffmpeg
MANIM_BINARY=manim
SANDBOX_MEMORY_LIMIT_MB=2048
SANDBOX_CPU_SECONDS=180
# RLIMIT_NPROC is per Unix user. Set a positive value only for a dedicated
# renderer account or a cgroup/container; use 0 for a shared local login.
SANDBOX_PROCESS_LIMIT=0
SANDBOX_ISOLATION=auto
